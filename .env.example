# Supabase — get these from your Supabase project dashboard
# Only the URL and anon key are required for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_SCHOOL_SLUG=school1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging/CI fallback names. Server-side code and scripts can use these when
# E2E_ENVIRONMENT=staging. Browser auth still works best when Vercel Preview
# also sets the normal NEXT_PUBLIC_* names to staging values.
# STAGING_NEXT_PUBLIC_SUPABASE_URL=
# STAGING_NEXT_PUBLIC_SUPABASE_ANON_KEY=
# STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Support/contact identity. This is displayed in the footer and can be used by
# support tooling.
SUPPORT_EMAIL=stormhubsupport@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=stormhubsupport@gmail.com
# Email delivery modes:
# disabled = no email rows/sends
# outbox_only = queue/log email rows without sending real email
# send = send real email through the configured provider
EMAIL_DELIVERY_MODE=outbox_only

# Optional: force demo mode even when Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=true

# The assistant stays disabled unless all three flags are true and a key exists.
AI_FEATURES_ENABLED=false
GROQ_ENABLED=false
AI_DATA_SHARING_APPROVED=false
# GROQ_API_KEY=

# OPTIONAL server-only — never expose to the client or commit to git.
# Required for trusted admin helpers such as notification fanout, exact roster
# reads, and platform school creation. Keep it server-only in Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# hCaptcha. The site key is public; the secret is server-only.
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# Optional signup hardening.
# SIGNUP_ACCESS_CODE=
# ALLOWED_SIGNUP_EMAIL_DOMAINS=example.edu,students.example.edu
# BLOCKED_SIGNUP_EMAIL_DOMAINS=gmail.com,outlook.com,yahoo.com
# SIGNUP_RATE_LIMIT_SECRET=generate-a-long-random-server-only-value
# REQUEST_RATE_LIMIT_SECRET=generate-a-different-long-random-server-only-value
# SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60
# SIGNUP_MAX_ATTEMPTS_PER_EMAIL=5
# SIGNUP_MAX_ATTEMPTS_PER_IP=50

# Optional Playwright E2E test accounts. Leave blank to skip authenticated E2E
# specs locally. Never commit real passwords.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# Required for any mutating E2E tests. Never set these against production.
# E2E_ENVIRONMENT=staging
# E2E_ALLOW_MUTATIONS=true
# EMAIL_DELIVERY_MODE=outbox_only
# E2E_TEST_PASSWORD=
# E2E_SUPER_ADMIN_EMAIL=e2e.superadmin@stormhub.test
# E2E_SUPER_ADMIN_PASSWORD=
# E2E_STUDENT_EMAIL=e2e.student.school1@stormhub.test
# E2E_STUDENT_PASSWORD=
# E2E_ADMIN_EMAIL=e2e.admin.school1@stormhub.test
# E2E_ADMIN_PASSWORD=
# E2E_TEACHER_EMAIL=e2e.teacher.school1@stormhub.test
# E2E_TEACHER_PASSWORD=

# Required when EMAIL_DELIVERY_MODE=send.
RESEND_API_KEY=
EMAIL_FROM="StormHub <noreply@stormhubapp.com>"
EMAIL_REPLY_TO=stormhubsupport@gmail.com

# Vercel uses this to authenticate scheduled digest requests.
# CRON_SECRET=generate-a-long-random-server-only-value
