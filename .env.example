# Supabase — get these from your Supabase project dashboard
# Only the URL and anon key are required for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: force demo mode even when Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=true

# OPTIONAL server-only — never expose to the client or commit to git.
# Not required for normal student flows (join clubs, RSVP, bookmarks, service hours).
# SUPABASE_SERVICE_ROLE_KEY=
