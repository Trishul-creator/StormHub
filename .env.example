# Supabase — get these from your Supabase project dashboard
# Only the URL and anon key are required for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_SCHOOL_SLUG=elkhorn-south
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support/contact identity. This is displayed in the footer and can be used by
# support tooling.
SUPPORT_EMAIL=stormhubsupport@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=stormhubsupport@gmail.com
# Use resend in production when real notification/feedback emails should send.
# Use in_app_only only if you intentionally want to disable outbound email.
EMAIL_DELIVERY_MODE=resend

# Optional: force demo mode even when Supabase is configured
# NEXT_PUBLIC_DEMO_MODE=true

# OPTIONAL server-only — never expose to the client or commit to git.
# Required for trusted admin helpers such as notification fanout, exact roster
# reads, and platform school creation. Keep it server-only in Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional signup hardening.
# SIGNUP_ACCESS_CODE=
# ALLOWED_SIGNUP_EMAIL_DOMAINS=example.edu,students.example.edu

# Required when EMAIL_DELIVERY_MODE=resend.
RESEND_API_KEY=
EMAIL_FROM="StormHub <notifications@stormhubapp.com>"
